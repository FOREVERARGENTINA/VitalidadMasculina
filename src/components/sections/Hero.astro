---
// Hero principal del homepage
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-panel">
      <div class="hero-line" aria-hidden="true"></div>
      <p class="hero-eyebrow">Práctica médica privada en salud masculina</p>

      <h1 id="hero-heading" class="hero-title">
        Medicina masculina<br />
        <span class="hero-title--accent">de precisión y máxima discreción</span>
      </h1>

      <p class="hero-subtitle">
        Diagnóstico integral, tratamiento personalizado y seguimiento cercano en un entorno reservado.
        Atención presencial en Capital Federal y videoconsulta para pacientes de toda Argentina.
      </p>

      <div class="hero-actions">
        <a href="/contacto" class="btn btn--primary">
          Coordinar consulta privada
        </a>
        <a href="#servicios" class="btn btn--outline">
          Explorar especialidades
        </a>
      </div>

      <div class="hero-trust">
        <span>Atención 1 a 1</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>Telemedicina premium</span>
        <span class="trust-sep" aria-hidden="true">·</span>
        <span>Confidencialidad absoluta</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    min-height: 62svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-bg-hero);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/hero.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(900px 420px at 14% 22%, rgba(201, 168, 76, 0.24), transparent 62%),
      linear-gradient(
        92deg,
        rgba(10, 29, 64, 0.84) 0%,
        rgba(14, 35, 72, 0.7) 42%,
        rgba(14, 35, 72, 0.34) 72%,
        rgba(14, 35, 72, 0.12) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: none;
    margin: 0;
    padding: 4rem clamp(1rem, 4.4vw, 3.75rem);
    width: 100%;
  }

  .hero-panel {
    width: min(100%, 660px);
    padding: clamp(1rem, 2.6vw, 1.55rem);
    background: linear-gradient(148deg, rgba(9, 25, 56, 0.56), rgba(9, 25, 56, 0.3));
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 20px;
    box-shadow: 0 18px 48px rgba(5, 16, 38, 0.28);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  @keyframes hero-line-grow {
    from { width: 0; opacity: 0; }
    to   { width: 80px; opacity: 1; }
  }

  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes cta-pulse {
    0%, 100% {
      box-shadow:
        0 8px 20px rgba(201, 168, 76, 0.28),
        0 0 0 0 rgba(201, 168, 76, 0);
    }
    50% {
      box-shadow:
        0 8px 28px rgba(201, 168, 76, 0.42),
        0 0 0 7px rgba(201, 168, 76, 0.07);
    }
  }

  .hero-line {
    width: 80px;
    height: 2px;
    background: rgba(131, 185, 255, 0.86);
    margin-bottom: 1.2rem;
    box-shadow: 0 0 6px rgba(131, 185, 255, 0.3);
    animation: hero-line-grow 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.05s;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--color-gold-light) 84%, var(--color-white));
    margin-bottom: 1.1rem;
    animation: hero-fade-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.22s;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--color-text-contrast);
    line-height: 1.05;
    letter-spacing: 0.01em;
    margin-bottom: 1rem;
    max-width: 620px;
    animation: hero-fade-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.38s;
  }

  .hero-title--accent {
    color: var(--color-gold);
  }

  .hero-subtitle {
    font-size: clamp(0.94rem, 1.5vw, 1.05rem);
    color: color-mix(in srgb, var(--color-text-contrast) 92%, var(--color-white));
    line-height: 1.72;
    max-width: 520px;
    margin-bottom: 1.5rem;
    animation: hero-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.58s;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
    animation: hero-fade-up 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.76s;
  }

  .hero .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.82rem 1.65rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: transform 0.15s ease, box-shadow 0.2s ease, background-color 0.2s;
    white-space: nowrap;
  }

  .hero .btn--primary {
    background-color: var(--color-gold);
    color: var(--color-ink-on-accent);
    box-shadow: 0 8px 20px rgba(201, 168, 76, 0.28);
    animation: cta-pulse 3s ease-in-out infinite;
    animation-delay: 1.6s;
  }

  .hero .btn--primary:hover {
    background-color: var(--color-gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(201, 168, 76, 0.38);
    animation-play-state: paused;
  }

  .hero .btn--outline {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-text-contrast);
    border: 1px solid rgba(255, 255, 255, 0.32);
  }

  .hero .btn--outline:hover {
    border-color: rgba(255, 255, 255, 0.52);
    background-color: rgba(255, 255, 255, 0.16);
    transform: translateY(-2px);
  }

  .hero-trust {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-contrast) 88%, var(--color-white));
    animation: hero-fade-up 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.92s;
  }

  .trust-sep {
    color: var(--color-gold-light);
    opacity: 0.6;
  }

  @media (max-width: 900px) {
    .hero-title {
      max-width: 100%;
    }

    .hero-panel {
      max-width: 100%;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 54svh;
    }

    .hero-content {
      padding: 2.4rem 1rem 2.8rem;
    }

    .hero-panel {
      border-radius: 14px;
      padding: 0.9rem 0.85rem 1rem;
    }

    .hero .btn {
      width: 100%;
    }
  }
</style>
