---
import {
  SITE_NAME,
  SITE_URL,
  MEDICO_NOMBRE,
  CONSULTORIO_ZONA,
  WHATSAPP_NUMBER,
  DEVELOPER_NAME,
  DEVELOPER_DESIGNER,
  DEVELOPER_URL,
  DEVELOPER_PHONE,
  INSTAGRAM_URL,
  SEO_CABA_LOCALIDADES,
} from '../utils/constants';
import WhatsAppBtn from '../components/ui/WhatsAppBtn.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
const DEFAULT_OG_IMAGE = '/images/og-image.jpg';
const ogImagePath = ogImage ?? DEFAULT_OG_IMAGE;
const ogImageURL = new URL(ogImagePath, SITE_URL).href;

function getOgImageType(path: string): string {
  const lowerPath = path.toLowerCase();
  if (lowerPath.endsWith('.png')) return 'image/png';
  if (lowerPath.endsWith('.jpg') || lowerPath.endsWith('.jpeg')) return 'image/jpeg';
  if (lowerPath.endsWith('.gif')) return 'image/gif';
  if (lowerPath.endsWith('.webp')) return 'image/webp';
  return 'image/jpeg';
}

const ogImageType = getOgImageType(ogImagePath);
const ogImageAlt = `${SITE_NAME} - ${title}`;

const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': SITE_URL + '/#business',
  name: SITE_NAME,
  description: 'Consultas especializadas en salud masculina en Capital Federal con ' + MEDICO_NOMBRE,
  url: SITE_URL,
  telephone: '+54 9 11 4096-9974',
  logo: {
    '@type': 'ImageObject',
    url: SITE_URL + '/images/logo.png',
    width: 300,
    height: 100,
  },
  image: SITE_URL + '/images/og-image.jpg',
  address: {
    '@type': 'PostalAddress',
    addressLocality: CONSULTORIO_ZONA,
    addressRegion: 'Buenos Aires',
    addressCountry: 'AR',
  },
  areaServed: [
    { '@type': 'Country', name: 'Argentina' },
    { '@type': 'City', name: 'Capital Federal' },
    { '@type': 'City', name: 'Palermo' },
    { '@type': 'City', name: 'Belgrano' },
    { '@type': 'City', name: 'Recoleta' },
    { '@type': 'City', name: 'Caballito' },
    { '@type': 'City', name: 'Villa Urquiza' },
    { '@type': 'City', name: 'Barrio Norte' },
    { '@type': 'City', name: 'N\u00fa\u00f1ez' },
    { '@type': 'City', name: 'Colegiales' },
    { '@type': 'City', name: 'Almagro' },
    { '@type': 'City', name: 'Puerto Madero' },
  ],
  availableService: [
    { '@type': 'MedicalTherapy', name: 'Disfunción Eréctil' },
    { '@type': 'MedicalTherapy', name: 'Eyaculación Precoz' },
    { '@type': 'MedicalTherapy', name: 'Falta de Deseo' },
    { '@type': 'MedicalTherapy', name: 'Terapia Hormonal con Pellets' },
    { '@type': 'MedicalTherapy', name: 'Urología Masculina' },
  ],
  medicalSpecialty: 'Urology',
  sameAs: [INSTAGRAM_URL],
  creator: {
    '@type': 'Organization',
    name: DEVELOPER_NAME,
    url: DEVELOPER_URL,
    telephone: DEVELOPER_PHONE,
    founder: {
      '@type': 'Person',
      name: DEVELOPER_DESIGNER,
    },
  },
};
---

<!doctype html>
<!--
  ============================================================
  Diseño y Desarrollo Web: Hernán — FrandoWeb
  Sitio: https://www.frandoweb.com
  Teléfono: +54 11 2807-4000
  ============================================================
-->
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Autoría y desarrollo -->
    <meta name="author" content={`${DEVELOPER_DESIGNER} — ${DEVELOPER_NAME}`} />
    <meta name="designer" content={`${DEVELOPER_DESIGNER} — ${DEVELOPER_NAME} | ${DEVELOPER_URL}`} />
    <meta name="web_author" content={DEVELOPER_NAME} />
    <meta name="owner" content={SITE_NAME} />
    <meta name="revisit-after" content="7 days" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Título y descripción -->
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={`salud masculina Capital Federal, urolog\u00eda Capital Federal, disfunci\u00f3n er\u00e9ctil Capital Federal, eyaculaci\u00f3n precoz Capital Federal, terapia hormonal Capital Federal, ${SEO_CABA_LOCALIDADES}`} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon-precomposed" sizes="57x57" href="/apple-touch-icon-57x57.png" />
    <link rel="apple-touch-icon-precomposed" sizes="60x60" href="/apple-touch-icon-60x60.png" />
    <link rel="apple-touch-icon-precomposed" sizes="72x72" href="/apple-touch-icon-72x72.png" />
    <link rel="apple-touch-icon-precomposed" sizes="76x76" href="/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon-precomposed" sizes="114x114" href="/apple-touch-icon-114x114.png" />
    <link rel="apple-touch-icon-precomposed" sizes="120x120" href="/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon-precomposed" sizes="144x144" href="/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon-precomposed" sizes="152x152" href="/apple-touch-icon-152x152.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png" />
    <link rel="icon" type="image/png" sizes="196x196" href="/favicon-196x196.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="msapplication-TileColor" content="#FFFFFF" />
    <meta name="msapplication-TileImage" content="/mstile-144x144.png" />
    <meta name="msapplication-square70x70logo" content="/mstile-70x70.png" />
    <meta name="msapplication-square150x150logo" content="/mstile-150x150.png" />
    <meta name="msapplication-wide310x150logo" content="/mstile-310x150.png" />
    <meta name="msapplication-square310x310logo" content="/mstile-310x310.png" />

    <!-- Fonts: preload de archivos críticos para reducir salto visual en primera carga -->
    <link rel="preload" href="/fonts/inter-v20-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-v20-latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-v40-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/playfair-display-v40-latin-700.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:secure_url" content={ogImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Schema.org MedicalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Slot para head adicional por página (meta robots, schema específico, etc.) -->
    <slot name="head" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JQH6CVW27R"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-JQH6CVW27R');
    </script>
  </head>

  <body>
    <!-- Desarrollado por Hernán — FrandoWeb | https://www.frandoweb.com | Tel: +54 11 2807-4000 -->
    <slot />

    <!-- Botón flotante WhatsApp — presente en todas las páginas -->
    <WhatsAppBtn />
  </body>
</html>
